fn closure() {
    let infix = |
        lhs: Result<ParserNode<'i>, Vec<Error<Rule>>>,
        op: Pair<'i, Rule>,
        rhs: Result<ParserNode<'i>, Vec<Error<Rule>>>
    | match op.as_rule() {
        _ => lhs,
    };
}
