int count_down(int n)
{
    int left = n;

    goto start;
    while (left > 0) {
        {
            int step = next_step(left);
            if (step > 1) {
                left -= step;
                report(left);
                left += 1;
            }
        }
start:
        left--;
    }
    return left;
}
