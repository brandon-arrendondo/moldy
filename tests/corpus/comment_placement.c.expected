int g(int a, int b, int c)
{
    int x;

    x =
        a ||    /* why a */
        b ||    /* why b */
        c;      /* why c */
    x = a &&
        (b || c);
    for (x = 0;
         x < a;
         x++) {
        x = a ? b
              : c;
    }
    return x;
}
